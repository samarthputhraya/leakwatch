# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Where data/, lake/, sim/ and index/ live. Use a path on the WSL disk, not /mnt/c (see docs/DECISIONS.md D-002).
# Leave empty to use <repo>/data.
LEAKWATCH_DATA_DIR=~/leakwatch-data

# Optional: a second YAML merged over configs/default.yaml (e.g. configs/full.yaml for full-scale runs).
LEAKWATCH_CONFIG=

# LLM (Phase 6). Any OpenAI-compatible endpoint whose model can call tools (D-026, D-035).
# Free options (no card), check with `make llm-check` before `make pe-eval`:
#   NVIDIA API catalog, key from build.nvidia.com:
#     LLM_BASE_URL=https://integrate.api.nvidia.com/v1  LLM_MODEL=meta/llama-3.3-70b-instruct  LLM_RPM=30
#   Groq free plan, key from console.groq.com:
#     LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile  LLM_RPM=25
#   Local CPU model (`make llm-local`, slow):
#     LLM_BASE_URL=http://127.0.0.1:8080/v1  LLM_API_KEY=local  LLM_MODEL=qwen3-4b-instruct-2507
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: requests per minute to stay under a free tier's limit (empty = no pacing).
LLM_RPM=
